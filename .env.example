# MNH Smart Calendar — environment variables (copy real values into your host's
# dashboard or a local .env that is NOT committed. Never put real secrets in git.)

# ---- Required in production (Render) ---------------------------------------
MNH_ENV=production
MNH_DATA_DIR=/var/data              # Render persistent disk; omit locally
MNH_ADMIN_PASSWORD=change-me        # Rep editing password
MNH_LECTURER_PASSWORD=change-me     # Staff editing password
# MNH_HOD_PASSWORD=                 # optional
# MNH_COORDINATOR_PASSWORD=         # optional
# MNH_ED_PASSWORD=                  # optional Executive Dean
# MNH_CORS_ORIGINS=                 # comma-separated origins if frontend hosted separately

# ---- WhatsApp sending (bridge on the Asterisk server — Meta Cloud API retired) ----
# MNH_WA_BRIDGE_URL=http://asterisk-host:3000   # WAHA or compatible HTTP bridge
# MNH_WA_BRIDGE_TOKEN=                          # bearer token if the bridge has auth
# MNH_WA_BRIDGE_STYLE=waha                      # waha | generic
# MNH_WA_BRIDGE_SESSION=default
# MNH_DEFAULT_COUNTRY=265           # Malawi, used for local-number normalisation

# ---- AI drafting + AI-triggered sending -------------------------------------
# MNH_AI_API_KEY=                   # required to enable the AI draft button
# MNH_AI_BASE_URL=https://api.openai.com/v1
# MNH_AI_MODEL=gpt-4o-mini
# MNH_AI_TRIGGER_ENABLED=0          # 1 = AI detects timetable changes and sends automatically

# ---- Asterisk ARI (voice calls) ---------------------------------------------
# MNH_ARI_BASE_URL=http://your-asterisk-host:8088/ari
# MNH_ARI_USER=mnh-calendar
# MNH_ARI_PASSWORD=change-me
# MNH_ARI_APP=mnh-calendar
# MNH_ARI_ENDPOINT=Local/{number}@mnh-outbound
# MNH_CALL_WINDOW_START=08:00       # Africa/Blantyre
# MNH_CALL_WINDOW_END=18:00
