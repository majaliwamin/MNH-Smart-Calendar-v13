# MNH Smart Calendar — environment variables.
# Put real secrets only in Render Environment / a local untracked .env file.
# Never commit real credentials or place them in frontend JavaScript.

# ---- Required in production (Render) ---------------------------------------
MNH_ENV=production
MNH_DATA_DIR=/var/data
MNH_ADMIN_PASSWORD=change-me
MNH_LECTURER_PASSWORD=change-me
# MNH_HOD_PASSWORD=
# MNH_COORDINATOR_PASSWORD=
# MNH_ED_PASSWORD=
# MNH_CORS_ORIGINS=

# ---- Local Windows PWA cloud mirror ----------------------------------------
# Set only on the laptop launcher, never on the deployed server. The local
# backend then forwards /api/* and the chat WebSocket to the deployed service.
# MNH_CLOUD_MIRROR_URL=https://mnh-smart-calendar-v13.onrender.com

# ---- WhatsApp sending -------------------------------------------------------
# MNH_WA_BRIDGE_URL=http://asterisk-host:3000
# MNH_WA_BRIDGE_TOKEN=
# MNH_WA_BRIDGE_STYLE=waha
# MNH_WA_BRIDGE_SESSION=default
# MNH_WA_SENDER_NUMBER=26599130362
# MNH_WA_PROFILE_NAME=Maternal & Neonatal Health Smart Time Table
# MNH_DEFAULT_COUNTRY=265

# ---- CRARA password-reset email (SMTP) --------------------------------------
# Required for "Forgot password?" links. Keep credentials in Render only.
# MNH_SMTP_HOST=smtp.example.com
# MNH_SMTP_PORT=587
# MNH_SMTP_SECURITY=starttls
# MNH_SMTP_USER=
# MNH_SMTP_PASSWORD=
# MNH_SMTP_FROM=CRARA <no-reply@example.com>
# Optional absolute public URL when the proxy scheme/host is not detected.
# MNH_PUBLIC_URL=https://mnh-smart-calendar-v13.onrender.com

# ---- CARA: provider priority Cloudflare -> Gemini -> Groq --------------------
MNH_CLASSREP_CLOUDFLARE_ACCOUNT_ID=
MNH_CLASSREP_CLOUDFLARE_API_KEY=
MNH_CLASSREP_CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
# Only the key is required for the free Gemini fallback; GEMINI_API_KEY is also
# accepted. The standard chat-completions-compatible endpoint and model have safe defaults.
MNH_CLASSREP_GEMINI_API_KEY=
# MNH_CLASSREP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MNH_CLASSREP_GEMINI_MODEL=gemini-3.5-flash-lite
# Only the key is required for the Groq fallback; the base URL defaults to
# Groq's standard chat-completions endpoint and can be overridden for a proxy.
MNH_CLASSREP_GROQ_API_KEY=
# MNH_CLASSREP_GROQ_BASE_URL=
# Optional: defaults to Groq's current fast 27B production model.
# MNH_CLASSREP_GROQ_MODEL=
MNH_CLASSREP_AI_TIMEOUT=35
MNH_CLASSREP_AI_MAX_TOKENS=900

# ---- CARA documents and voice -------------------------------------------------
# Use a long random value; keep it only in Render Environment, never GitHub code.
MNH_CLASSREP_DOCUMENT_ADMIN_TOKEN=
MNH_CLASSREP_CLOUDFLARE_STT_MODEL=
MNH_CLASSREP_CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-2-en
MNH_CLASSREP_CLOUDFLARE_EMBEDDING_MODEL=@cf/google/embeddinggemma-2
MNH_CLASSREP_TTS_SPEAKER=luna

# TTS provider: cloudflare (default) | qwen3 (local qwen-tts) | qwen_remote (HF ZeroGPU/self-hosted OpenAI-compatible /v1/audio/speech, experimental) | openai_compatible
MNH_CLASSREP_TTS_PROVIDER=cloudflare
MNH_CLASSREP_TTS_FALLBACK=1
# Qwen3-TTS local/in-process settings (used when provider=qwen3)
MNH_CLASSREP_QWEN3_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
MNH_CLASSREP_QWEN3_SPEAKER=Ryan
MNH_CLASSREP_QWEN3_DEVICE=auto
MNH_CLASSREP_QWEN3_DTYPE=bfloat16
MNH_CLASSREP_QWEN3_ATTN_IMPL=sdpa
# Remote/experimental Qwen3-TTS (recommended no-CC recurring option: Hugging Face ZeroGPU Space; see deployment/hf_zerogpu_qwen_tts/)
# 5 GPU-min/day on HF ZeroGPU means GPU processing time, not audio minutes. Cache/pre-generate for 5-slide tests.
# QWEN_TTS_ENABLED=false
# QWEN_TTS_BASE_URL=https://<your-space>.hf.space
# QWEN_TTS_API_KEY=
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# QWEN_TTS_TIMEOUT_SECONDS=120
# QWEN_TTS_CONNECT_TIMEOUT_SECONDS=10
# QWEN_TTS_MAX_TEXT_LENGTH=1800
# QWEN_TTS_FALLBACK_ENABLED=true
# MNH aliases also supported:
# MNH_CLASSREP_TTS_API_BASE_URL=
# MNH_CLASSREP_TTS_API_KEY=
# MNH_CLASSREP_TTS_API_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# ---- Public community chat (optional tuning) --------------------------------
# Guest identity cookies are HMAC-signed. Set a long random secret in Render;
# if omitted, the existing admin password is used as the signing material.
# MNH_PUBLIC_CHAT_SECRET=
# MNH_PUBLIC_CHAT_RETENTION_DAYS=7
# MNH_PUBLIC_CHAT_EXPIRE_PRIVATE=0
# MNH_PUBLIC_CHAT_CLEANUP_LOG_DAYS=30
# MNH_PUBLIC_CHAT_REQUIRE_APPROVAL=0
# MNH_PUBLIC_CHAT_RATE_MESSAGES=30
# MNH_PUBLIC_CHAT_RATE_UPLOADS=10
# MNH_PUBLIC_CHAT_RATE_REPORTS=10

# ---- CRARA one-to-one classroom (LiveKit) -----------------------------------
# All three values are required before the classroom button becomes usable.
MNH_LIVEKIT_URL=
MNH_LIVEKIT_API_KEY=
MNH_LIVEKIT_API_SECRET=
# MNH_LIVEKIT_TOKEN_TTL_SECONDS=7200
# MNH_LIVEKIT_HANDOFF_TTL_SECONDS=600

# ---- Optional Communications Centre AI -------------------------------------
# Configure an endpoint and model from a provider you have selected.
# MNH_COMM_AI_API_KEY=
# MNH_COMM_AI_BASE_URL=
# MNH_COMM_AI_MODEL=
# MNH_COMM_AI_TRIGGER_ENABLED=0

# ---- Asterisk ARI (voice calls) ----------------------------------------------
# MNH_ARI_BASE_URL=http://your-asterisk-host:8088/ari
# MNH_ARI_USER=mnh-calendar
# MNH_ARI_PASSWORD=change-me
# MNH_ARI_APP=mnh-calendar
# MNH_ARI_ENDPOINT=Local/{number}@mnh-outbound
# MNH_CALL_WINDOW_START=08:00
# MNH_CALL_WINDOW_END=18:00

# Optional CPU OCR for scanned PDFs and image uploads.
# Install backend/requirements-ocr.txt to enable both engines.
MNH_CLASSREP_OCR_ENGINE=auto
