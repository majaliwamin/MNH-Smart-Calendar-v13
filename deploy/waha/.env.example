# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#
# Generate a strong API key:
#   uuidgen | tr -d '-'
# or on a machine without uuidgen:
#   openssl rand -hex 16

# The API key the MNH app authenticates with (sent as X-Api-Key).
# Put this exact value in Render as MNH_WA_BRIDGE_TOKEN.
WAHA_API_KEY=replace-with-a-long-random-value

# Dashboard login (separate from the API key).
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-strong-password
